# SecureStay Real Estates - Environment Configuration

# Server Port
PORT=5000
NODE_ENV=development

# MongoDB Connection URI (Local or MongoDB Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/securestay_db

# JWT Authentication Secret
JWT_SECRET=securestay_jwt_super_secret_production_key_2026

# OAuth Credentials (Optional - configure for production social login)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Cloudinary / Image Storage (Optional - falls back to local uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# CORS Allowed Origin
CLIENT_ORIGIN=http://localhost:5173
